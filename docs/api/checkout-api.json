{
  "openapi": "3.0.1",
  "info": {
    "title": "默认模块",
    "description": "",
    "version": "1.0.0"
  },
  "tags": [],
  "paths": {
    "/checkout/web/session/{sessionId}": {
      "post": {
        "summary": "加载 Checkout 会话",
        "deprecated": false,
        "description": "<p>\n返回渲染支付页面所需的全部信息（商品信息、支持的支付方式、商户信息等）。\nEmbedded / SDK 场景须在请求体中携带 checkoutClientSecret，服务端校验后返回；\nHPP 场景不传 checkoutClientSecret，服务端跳过令牌校验。",
        "tags": [],
        "parameters": [
          {
            "name": "sessionId",
            "in": "path",
            "description": "会话 ID",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoadSessionReq",
                "description": "请求体（Embedded / SDK 场景携带 checkoutClientSecret）"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResultLoadSessionResp",
                  "description": "会话信息（含商品、金额、支付方式列表、商户信息）"
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/checkout/web/link/{linkId}": {
      "post": {
        "summary": "加载 Pay By Link 会话",
        "deprecated": false,
        "description": "<p>\n通过支付链接 ID 加载对应会话，返回渲染支付页面所需的全部信息。\nPay By Link 场景无需令牌，服务端直接返回会话信息。",
        "tags": [],
        "parameters": [
          {
            "name": "linkId",
            "in": "path",
            "description": "支付链接 ID",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoadSessionReq",
                "description": ""
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResultLoadSessionResp",
                  "description": "会话信息（含商品、金额、支付方式列表、商户信息）"
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/checkout/web/payment/submit": {
      "post": {
        "summary": "提交支付",
        "deprecated": false,
        "description": "<p>\n支持新卡支付（CARD / GOOGLE_PAY / APPLE_PAY）和已存卡支付（TOKEN）两种路径。\n新卡支付须携带加密卡数据；TOKEN 支付须携带 savedCardId 和 customerAccessSecret。\nEmbedded / SDK 场景新卡支付须额外携带 checkoutClientSecret。\n<p>\n支付状态说明：S - 成功；F - 失败；R - 需要后续操作（见 action 字段）。",
        "tags": [],
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitSessionPaymentReq",
                "description": "支付请求"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResultSubmitSessionPaymentResp",
                  "description": "支付结果（含 txnId、txnStatus，状态为 R 时含 action）"
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/checkout/web/payment/result/{sessionId}": {
      "post": {
        "summary": "查询支付结果",
        "deprecated": false,
        "description": "<p>\n用于前端轮询或异步获取支付状态。支付状态为终态（S / F）前可持续轮询，\n状态为 R 时表示需要等待后续操作完成。",
        "tags": [],
        "parameters": [
          {
            "name": "sessionId",
            "in": "path",
            "description": "会话 ID",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoadSessionReq",
                "description": ""
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResultSubmitSessionPaymentResp",
                  "description": "支付结果（含 txnId、txnStatus）"
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/checkout/web/card/list": {
      "post": {
        "summary": "列出已保存卡片（Card on File）",
        "deprecated": false,
        "description": "<p>\nSDK 携带有效的 customerAccessSecret 调用本接口，查询当前 Customer 在本商户下已保存的卡片列表。\n响应中使用不透明的 savedCardId 替代真实 tokenId，防止令牌泄露；\n用卡支付时将 savedCardId 传入 submitPayment 接口。",
        "tags": [],
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CardListReq",
                "description": "列卡请求（含 sessionId 和 customerAccessSecret）"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResultCardListResp",
                  "description": "卡片列表（含 savedCardId、脱敏卡号、卡品牌、过期日）"
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/checkout/web/card/bin/recognize": {
      "post": {
        "summary": "识别卡BIN",
        "deprecated": false,
        "description": "<p>\n前端传入卡BIN（6~9 位数字），服务端调用内部卡BIN服务识别其卡品牌、卡类型等信息。\n识别失败（未命中）时返回字段为空的响应。",
        "tags": [],
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CardBinRecognizeReq",
                "description": "卡BIN识别请求（含 bin）"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResultCardBinRecognizeResp",
                  "description": "卡品牌识别结果（含 cardScheme、cardType 等）"
                }
              }
            }
          }
        },
        "security": []
      }
    }
  },
  "components": {
    "schemas": {
      "Product": {
        "type": "object",
