# Copy to .env.local (git-ignored) and fill in. Never commit real values.
API_KEY=
APP_ID=
MERCHANT_ID=
# Optional
CUSTOMER_ID=sunbay-ios-dev-customer
OPEN_API_URL=https://open.sunbay-dev.com
CURRENCY=USD
PORT=8095
# Default 0.0.0.0 (all interfaces) so a real device on the LAN can reach it.
# WARNING: this exposes an unauthenticated, credential-backed session creator to the network.
# Use a trusted network only; set HOST=127.0.0.1 to keep it on loopback.
HOST=0.0.0.0
