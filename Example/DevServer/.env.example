# Copy to .env.local (git-ignored) and fill in. Never commit real values.
API_KEY=
APP_ID=
MERCHANT_ID=
# Optional
CUSTOMER_ID=sunbay-ios-dev-customer
OPEN_API_URL=https://open.sunbay-dev.com
CURRENCY=USD
PORT=8095
# WARNING: binding to a non-loopback address (e.g. 0.0.0.0) exposes an unauthenticated,
# credential-backed session creator to the network. Keep it on loopback.
HOST=127.0.0.1
